# =============================================================================
# LANDING PAGE CONFIGURATION
# =============================================================================
# Copy variabel ini ke file .env Anda untuk mengkustomisasi landing page
# 
# ⚠️ WARNING: Jangan biarkan value kosong (LANDING_KEY="") karena akan
#    meng-override nilai default di config. Jika tidak ingin di-set,
#    hapus baris tersebut atau comment dengan # di awal baris.
# =============================================================================

# ---------------------------------------------------------------------------
# Konten Hero Section
# ---------------------------------------------------------------------------

# Tagline/badge yang muncul di atas judul (contoh: "Solusi Digital Pesantren #1")
LANDING_TAGLINE="Solusi Digital Pesantren #1 di Indonesia"

# Judul utama hero section (contoh: "Kelola Pesantren Lebih Mudah")
LANDING_TITLE="Kelola Pesantren Lebih Mudah"

# Deskripsi/subtitle hero section (dapat multi-line dengan \
# untuk newline jika diperlukan)
LANDING_SUBTITLE="Platform all-in-one untuk manajemen santri, akademik, keuangan, dan asrama. Transformasi digital pondok pesantren Anda dimulai dari sini."

# ---------------------------------------------------------------------------
# Tombol Call-to-Action (CTA)
# ---------------------------------------------------------------------------

# Text tombol utama (biasanya menuju login/register)
LANDING_CTA_PRIMARY="Mulai Sekarang"

# Text tombol sekunder (biasanya menuju kontak)
LANDING_CTA_SECONDARY="Hubungi Kami"

# ---------------------------------------------------------------------------
# Informasi Kontak
# ---------------------------------------------------------------------------

# Nomor WhatsApp dengan format readable (akan otomatis di-convert ke format wa.me)
# Contoh: 0812-3456-7890 atau +62 812-3456-7890
LANDING_WHATSAPP="0812-3456-7890"

# Alamat email kontak
LANDING_EMAIL="info@kelolapesantren.com"

# Alamat lengkap (opsional, default: Indonesia)
LANDING_ADDRESS="Indonesia"

# URL Google Maps (opsional)
# LANDING_MAPS_URL="https://maps.google.com/?q=nama-pesantren"

# ---------------------------------------------------------------------------
# Social Media Links (opsional, kosongkan jika tidak digunakan)
# ---------------------------------------------------------------------------

# LANDING_FACEBOOK_URL="https://facebook.com/namaakun"
# LANDING_INSTAGRAM_URL="https://instagram.com/namaakun"
# LANDING_TWITTER_URL="https://twitter.com/namaakun"
# LANDING_YOUTUBE_URL="https://youtube.com/c/namachannel"

# ---------------------------------------------------------------------------
# Override Nama Aplikasi (opsional)
# ---------------------------------------------------------------------------

# Jika ingin nama berbeda di landing page vs aplikasi utama
# LANDING_APP_NAME="Nama Brand Pesantren"

# =============================================================================
