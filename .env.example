APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://pesantren.test

# ===========================================
# SaaS Multi-Tenant Configuration
# ===========================================

# Local Development:
# APP_DOMAIN=pesantren.test
# APP_SCHEME=http
#
# Production Example:
# APP_DOMAIN=pesantrendiniyah.my.id
# APP_SCHEME=https

APP_DOMAIN=pesantren.test
APP_SCHEME=http

# Tenant domain pattern
# tenant.pesantren.test
# tenant.pesantrendiniyah.my.id

TENANT_DOMAIN={tenant}.pesantren.test


SESSION_DOMAIN=.pesantren.test

# ===========================================

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Public contact information shown on the landing page
# See also: config/landing.php
LANDING_WHATSAPP="0812-3456-7890"
LANDING_EMAIL="info@kelolapesantren.com"
LANDING_ADDRESS="Indonesia"

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===========================================
# Database
# ===========================================

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nama_database
DB_USERNAME=root
DB_PASSWORD=

# ===========================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===========================================
# Queue Configuration
# ===========================================
#
# Supported drivers: sync, database, redis, beanstalkd, sqs
# Production: use redis or database (redis recommended for high volume)
# Development: sync (immediate execution) or database
#
# Queue Names Used:
#   - default      : General purpose jobs
#   - notifications: Email and push notifications
#   - reminders    : Bill due and payment reminders
#

QUEUE_CONNECTION=database

# Database Queue Settings
DB_QUEUE_CONNECTION=null
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90

# Redis Queue Settings (when QUEUE_CONNECTION=redis)
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90

# ===========================================
# Mail
# ===========================================
#
# Development: MAIL_MAILER=log (emails written to laravel.log)
# Staging:     MAIL_MAILER=smtp with Mailtrap credentials
# Production:  MAIL_MAILER=smtp with real SMTP (e.g. SendGrid, Mailgun, SES)
#
# Production example (SendGrid):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=SG.your-api-key
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="noreply@pesantren.id"
# MAIL_FROM_NAME="Sistem Pesantren"

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@pesantren.local"
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# Reminder Notifications
# ===========================================

REMINDER_EMAIL_ENABLED=true
REMINDER_WHATSAPP_ENABLED=false
REMINDER_DAYS_BEFORE=3
REMINDER_QUEUE_NAME=reminders
REMINDER_QUEUE_CONNECTION=

# ===========================================
# General Notifications
# ===========================================

NOTIFICATION_WELCOME_EMAIL_ENABLED=true
NOTIFICATION_PASSWORD_RESET_EMAIL_ENABLED=true
NOTIFICATION_BUG_REPORT_RECIPIENT=
NOTIFICATION_BUG_REPORT_FROM_ADDRESS=
NOTIFICATION_BUG_REPORT_FROM_NAME=

# ===========================================
# Usage Monitoring & Limit Enforcement
# ===========================================
#
# Controls how the system tracks tenant usage against plan limits.
# All values have sensible defaults if not set.

# Threshold percentage for "approaching limits" alerts (default: 80.0)
USAGE_APPROACHING_THRESHOLD=80.0

# Days to look back for recent usage logs in UI (default: 30)
USAGE_RECENT_DAYS=30

# Pagination per page for usage monitoring dashboard (default: 20)
USAGE_PER_PAGE=20

# ===========================================
# WhatsApp Integration
# ===========================================
#
# Supported providers: twilio, fonnte, wablas
# Choose based on your region and requirements:
#   - Twilio: International, official WhatsApp Business API
#   - Fonnte: Indonesia-focused, simple API
#   - Wablas: Indonesia-focused, supports devices
#

# Global settings
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=twilio
WHATSAPP_DEFAULT_SENDER=

# Queue settings
WHATSAPP_QUEUE_ENABLED=true
WHATSAPP_QUEUE_NAME=notifications
WHATSAPP_QUEUE_CONNECTION=

# Retry settings
WHATSAPP_RETRY_TRIES=3

# Rate limiting
WHATSAPP_RATE_LIMIT_ENABLED=true
WHATSAPP_RATE_LIMIT_PER_MINUTE=30

# Tenant override (allow per-tenant WhatsApp config)
WHATSAPP_TENANT_OVERRIDE=false

# Template settings
WHATSAPP_TEMPLATE_FOOTER="_Sistem Pesantren Digital_"
WHATSAPP_TEMPLATE_LANGUAGE=id

# --- Twilio Configuration ---
WHATSAPP_TWILIO_ENABLED=false
WHATSAPP_TWILIO_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=
WHATSAPP_TWILIO_API_URL=https://api.twilio.com/2010-04-01

# --- Fonnte Configuration ---
WHATSAPP_FONNTE_ENABLED=false
WHATSAPP_FONNTE_TOKEN=
WHATSAPP_FONNTE_API_URL=https://api.fonnte.com/send
WHATSAPP_FONNTE_COUNTRY_CODE=62

# --- Wablas Configuration ---
WHATSAPP_WABLAS_ENABLED=false
WHATSAPP_WABLAS_TOKEN=
WHATSAPP_WABLAS_API_URL=
WHATSAPP_WABLAS_DEVICE_ID=

# ===========================================
# AWS
# ===========================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ===========================================
# Testing Environment (phpunit)
# ===========================================
# Copy ke .env.testing untuk testing
#
# APP_ENV=testing
# APP_KEY=base64:your-test-key-here
# DB_DATABASE=pesantren_test
# DB_USERNAME=root
# DB_PASSWORD=
# QUEUE_CONNECTION=sync
# MAIL_MAILER=log
# BROADCAST_CONNECTION=null
# CACHE_STORE=array
# SESSION_DRIVER=array

# ===========================================
# Vite
# ===========================================

VITE_APP_NAME="${APP_NAME}"

# Development only
VITE_DEV_SERVER_PORT=5173
VITE_DEV_SERVER_HMR_HOST=localhost

# ===========================================
# Payment Gateway
# ===========================================
#
# Supported: null (manual/offline), midtrans, xendit
# Use "null" in development (no external dependency)
#

PAYMENT_GATEWAY=null

# Midtrans (Snap API)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Xendit (Invoice API)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_IS_PRODUCTION=false